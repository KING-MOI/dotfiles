[core]
	editor = nvim
	pager = command -v delta >/dev/null && delta || less -FRX
	autocrlf = input
	whitespace = trailing-space,space-before-tab
	excludesfile = ~/.config/git/ignore

[commit]
	template = ~/.config/git/message
	verbose = true

[init]
	defaultBranch = main

[pull]
	rebase = true

[push]
	default = current
	autoSetupRemote = true

[fetch]
	prune = true

[merge]
	conflictstyle = zdiff3

[diff]
	algorithm = histogram
	colorMoved = default

[rerere]
	enabled = true

[rebase]
	autoStash = true
	autoSquash = true

[interactive]
	diffFilter = command -v delta >/dev/null && delta --color-only || cat

[delta]
	navigate = true
	line-numbers = true
	side-by-side = false

[color]
	ui = auto

[alias]
	st = status -sb
	co = checkout
	sw = switch
	br = branch -vv
	ci = commit
	amend = commit --amend --no-edit
	unstage = restore --staged
	last = log -1 HEAD --stat
	lg = log --graph --pretty=format:'%C(yellow)%h%Creset %C(blue)%ad%Creset %s%C(red)%d%Creset %C(dim)<%an>%Creset' --date=short
	undo = reset --soft HEAD~1
	wip = !git add -A && git commit -m wip --no-verify
	aliases = !git config --get-regexp '^alias\\.' | sed 's/^alias\\.//'

[include]
	path = ~/.gitconfig.local
